-- Get Character
local function GetCharacter()
    return Player.Character
end

-- Get Root Part
local function GetRoot()
    local char = GetCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Get Humanoid
local function GetHumanoid()
    local char = GetCharacter()
    return char and char:FindFirstChild("Humanoid")
end

-- Teleport Function
local function TeleportTo(cframe)
    local root = GetRoot()
    if root then
        root.CFrame = cframe
    end
end

-- Tween Teleport
local function TweenTo(cframe)
    local root = GetRoot()
    if root and cframe then
        local distance = (root.Position - cframe.Position).Magnitude
        local speed = 300
        local time = distance / speed
        
        local tween = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = cframe})
        tween:Play()
        return tween
    end
end

-- Equip Tool
local function EquipTool(toolName)
    local char = GetCharacter()
    if not char then return false end
    
    local tool = Player.Backpack:FindFirstChild(toolName) or char:FindFirstChild(toolName)
    if tool and tool:IsA("Tool") then
        local hum = GetHumanoid()
        if hum then
            hum:EquipTool(tool)
            return true
        end
    end
    return false
end

-- Equip Best Tool
local function EquipBestTool()
    local FarmTool = getgenv().FarmTool or "Melee"
    local char = GetCharacter()
    if not char then return end
    
    if FarmTool == "Melee" then
        -- Equip melee weapon
        for _, tool in pairs(Player.Backpack:GetChildren()) do
            if tool:IsA("Tool") and not tool:FindFirstChild("Requirement") then
                local hum = GetHumanoid()
                if hum then hum:EquipTool(tool) break end
            end
        end
    elseif FarmTool == "Sword" then
        -- Equip sword
        for _, tool in pairs(Player.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == "Sword" then
                local hum = GetHumanoid()
                if hum then hum:EquipTool(tool) break end
            end
        end
    elseif FarmTool == "Blox Fruit" then
        -- Equip fruit
        for _, tool in pairs(Player.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool:FindFirstChild("Fruit") then
                local hum = GetHumanoid()
                if hum then hum:EquipTool(tool) break end
            end
        end
    end
end

