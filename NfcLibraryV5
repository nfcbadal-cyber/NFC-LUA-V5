-- AIMBOT SYSTEM
-- ═══════════════════════════════════════════════════════════════════════

local Aimbot = {}

function Aimbot:GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = Config.Aimbot.FOV
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not Utility:IsAlive(player) then continue end
        
        -- Team Check
        if Config.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then
            continue
        end
        
        -- Friend Check
        if Config.Aimbot.IgnoreFriends and player:IsFriendsWith(LocalPlayer.UserId) then
            continue
        end
        
        local character = Utility:GetCharacter(player)
        if not character then continue end
        
        local targetPart = nil
        
        if Config.Aimbot.ClosestPart then
            targetPart = Utility:GetClosestBodyPart(character)
        else
            targetPart = Utility:GetBodyPart(character, Config.Aimbot.AimPart)
        end
        
        if not targetPart then continue end
        
        -- Visibility Check
        if Config.Aimbot.VisibleCheck then
            if not Utility:IsOnScreen(targetPart.Position) then
                continue
            end
        end
        
        -- Wall Check
        if Config.Aimbot.WallCheck then
            if not Utility:RaycastCheck(player) then
                continue
            end
        end
        
        local screenPos, onScreen = Utility:WorldToScreen(targetPart.Position)
        if not onScreen and Config.Aimbot.VisibleCheck then continue end
        
        local mousePos = UserInputService:GetMouseLocation()
        local distance = (screenPos - mousePos).Magnitude
        
        if distance < shortestDistance then
            closestPlayer = player
            shortestDistance = distance
        end
    end
    
    return closestPlayer
end

function Aimbot:IsTargetValid(target)
    if not target or target == LocalPlayer then return false end
    if not Utility:IsAlive(target) then return false end
    
    -- Team Check
    if Config.Aimbot.TeamCheck and target.Team == LocalPlayer.Team then
        return false
    end
    
    local character = Utility:GetCharacter(target)
    if not character then return false end
    
    local targetPart = Utility:GetBodyPart(character, Config.Aimbot.AimPart)
    if not targetPart then return false end
    
    -- Wall Check
    if Config.Aimbot.WallCheck then
        if not Utility:RaycastCheck(target) then
            return false
        end
    end
    
    return true
end

function Aimbot:GetAimPosition(target)
    local character = Utility:GetCharacter(target)
    if not character then return nil end
    
    local targetPart = nil
    
    if Config.Aimbot.ClosestPart then
        targetPart = Utility:GetClosestBodyPart(character)
    else
        targetPart = Utility:GetBodyPart(character, Config.Aimbot.AimPart)
    end
    
    if not targetPart then return nil end
    
    local aimPosition = targetPart.Position
    
    -- Prediction
    if Config.Aimbot.Prediction then
        aimPosition = Utility:PredictPosition(targetPart, Config.Aimbot.PredictionAmount)
    end
    
    -- Air Shot Compensation
    if Config.Aimbot.AirShotCompensation then
        local humanoid = Utility:GetHumanoid(character)
        if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Freefall then
            aimPosition = aimPosition + Vector3.new(0, Config.Aimbot.JumpOffset, 0)
        end
    end
    
    -- Offsets
    aimPosition = aimPosition + Vector3.new(
        Config.Aimbot.XOffset,
        Config.Aimbot.YOffset,
        Config.Aimbot.ZOffset
    )
    
    -- Shake
    if Config.Aimbot.Shake then
        local shake = Vector3.new(
            math.random(-Config.Aimbot.ShakeValue, Config.Aimbot.ShakeValue),
            math.random(-Config.Aimbot.ShakeValue, Config.Aimbot.ShakeValue),
            math.random(-Config.Aimbot.ShakeValue, Config.Aimbot.ShakeValue)
        )
        aimPosition = aimPosition + shake
    end
    
    return aimPosition
end

function Aimbot:SmoothAim(targetPosition)
    if not targetPosition then return end
    
    local camera = Camera.CFrame
    local targetCFrame = CFrame.new(camera.Position, targetPosition)
    
    local smoothness = Config.Aimbot.Smoothness
    
    -- Smooth Types
    if Config.Aimbot.SmoothType == "Sine" then
        smoothness = math.sin(smoothness * (math.pi / 2))
    elseif Config.Aimbot.SmoothType == "Quad" then
        smoothness = smoothness * smoothness
    end
    
    Camera.CFrame = camera:Lerp(targetCFrame, smoothness)
end

function Aimbot:InstantAim(targetPosition)
    if not targetPosition then return end
    
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
end

function Aimbot:Update()
    if not Config.Aimbot.Enabled then
        CurrentTarget = nil
        return
    end
    
    -- Aimlock Mode
    if Config.Aimbot.AimlockEnabled then
        if UserInputService:IsKeyDown(Config.Aimbot.AimlockKey) then
            -- Sticky Lock Mode
            if Config.Aimbot.StickyLock then
                -- If no locked target, find one
                if not LockedTarget or not self:IsTargetValid(LockedTarget) then
                    LockedTarget = self:GetClosestPlayer()
                end
                
                -- Aim at locked target
                if LockedTarget then
                    local aimPos = self:GetAimPosition(LockedTarget)
                    if aimPos then
                        self:InstantAim(aimPos)
                    end
                end
            else
                -- Normal Aimlock (re-targets each frame)
                local target = self:GetClosestPlayer()
                if target then
                    local aimPos = self:GetAimPosition(target)
                    if aimPos then
                        self:InstantAim(aimPos)
                    end
                end
            end
        else
            -- Release lock when key is released
            LockedTarget = nil
        end
    else
        -- Normal Aimbot (smooth)
        local target = self:GetClosestPlayer()
        if target then
            CurrentTarget = target
            local aimPos = self:GetAimPosition(target)
            if aimPos then
                self:SmoothAim(aimPos)
            end
        else
            CurrentTarget = nil
        end
    end
end

