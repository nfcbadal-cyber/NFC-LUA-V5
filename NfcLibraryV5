local ESP = {}

function ESP:CreateDrawing(type, properties)
    local drawing = Drawing.new(type)
    
    for property, value in pairs(properties) do
        drawing[property] = value
    end
    
    return drawing
end

function ESP:RemoveESP(player)
    if ESPObjects[player] then
        for _, drawing in pairs(ESPObjects[player]) do
            if drawing then
                pcall(function()
                    drawing:Remove()
                end)
            end
        end
        ESPObjects[player] = nil
    end
end

function ESP:CreateESP(player)
    if player == LocalPlayer then return end
    if ESPObjects[player] then return end
    
    local espData = {
        Box = nil,
        BoxOutline = nil,
        Name = nil,
        Distance = nil,
        Health = nil,
        HealthBar = nil,
        HealthBarOutline = nil,
        Tracers = nil,
        HeadDot = nil,
        Chams = nil,
        Skeleton = {}
    }
    
    -- Box ESP
    if Config.ESP.BoxEnabled then
        espData.BoxOutline = self:CreateDrawing("Square", {
            Thickness = Config.ESP.BoxThickness + 1,
            Filled = false,
            Color = Color3.fromRGB(0, 0, 0),
            Visible = false
        })
        
        espData.Box = self:CreateDrawing("Square", {
            Thickness = Config.ESP.BoxThickness,
            Filled = Config.ESP.BoxFilled,
            Color = Config.ESP.BoxColor,
            Transparency = 1,
            Visible = false
        })
    end
    
    -- Name ESP
    if Config.ESP.NameEnabled then
        espData.Name = self:CreateDrawing("Text", {
            Text = player.Name,
            Size = Config.ESP.NameSize,
            Center = true,
            Outline = Config.ESP.NameOutline,
            Color = Config.ESP.NameColor,
            Visible = false
        })
    end
    
    -- Tracer ESP
    if Config.ESP.TracerEnabled then
        espData.Tracers = self:CreateDrawing("Line", {
            Thickness = Config.ESP.TracerThickness,
            Color = Config.ESP.TracerColor,
            Transparency = Config.ESP.TracerTransparency,
            Visible = false
        })
    end
    
    -- Health Bar
    if Config.ESP.HealthBarEnabled then
        espData.HealthBarOutline = self:CreateDrawing("Line", {
            Thickness = Config.ESP.HealthBarSize + 1,
            Color = Color3.fromRGB(0, 0, 0),
            Visible = false
        })
        
        espData.HealthBar = self:CreateDrawing("Line", {
            Thickness = Config.ESP.HealthBarSize,
            Color = Color3.fromRGB(0, 255, 0),
            Visible = false
        })
    end
    
    -- Head Dot
    if Config.ESP.HeadDotEnabled then
        espData.HeadDot = self:CreateDrawing("Circle", {
            Radius = Config.ESP.HeadDotSize,
            Filled = true,
            Color = Config.ESP.HeadDotColor,
            Visible = false
        })
    end
    
    -- Chams (Highlight)
    if Config.ESP.ChamsEnabled then
        local character = Utility:GetCharacter(player)
        if character then
            local highlight = Instance.new("Highlight")
            highlight.Parent = character
            highlight.FillColor = Config.ESP.ChamsFillColor
            highlight.OutlineColor = Config.ESP.ChamsOutlineColor
            highlight.FillTransparency = Config.ESP.ChamsFillTransparency
            highlight.OutlineTransparency = Config.ESP.ChamsOutlineTransparency
            espData.Chams = highlight
        end
    end
    
    ESPObjects[player] = espData
end

function ESP:UpdateESP(player)
    if player == LocalPlayer then return end
    if not Config.ESP.Enabled then return end
    
    -- Team Check
    if Config.ESP.TeamCheck and player.Team == LocalPlayer.Team then
        self:RemoveESP(player)
        return
    end
    
    if not Utility:IsAlive(player) then
        self:RemoveESP(player)
        return
    end
    
    if not ESPObjects[player] then
        self:CreateESP(player)
    end
    
    local espData = ESPObjects[player]
    if not espData then return end
    
    local character = Utility:GetCharacter(player)
    if not character then return end
    
    local rootPart = Utility:GetRootPart(character)
    if not rootPart then return end
    
    local head = Utility:GetBodyPart(character, "Head")
    
    -- Get screen positions
    local rootPos, rootOnScreen = Utility:WorldToScreen(rootPart.Position)
    
    if not rootOnScreen then
        for _, drawing in pairs(espData) do
            if drawing and type(drawing) ~= "table" and drawing.Visible then
                drawing.Visible = false
            end
        end
        return
    end
    
    local headPos = rootPos
    if head then
        headPos = Utility:WorldToScreen(head.Position + Vector3.new(0, 0.5, 0))
    end
    
    local legPos = Utility:WorldToScreen(rootPart.Position - Vector3.new(0, 3, 0))
    
    -- Calculate box size
    local height = (headPos - legPos).Magnitude
    local width = height / 2
    
    -- Update Box
    if Config.ESP.BoxEnabled and espData.Box then
        espData.Box.Size = Vector2.new(width, height)
        espData.Box.Position = Vector2.new(rootPos.X - width / 2, headPos.Y)
        espData.Box.Visible = true
        
        if espData.BoxOutline then
            espData.BoxOutline.Size = Vector2.new(width, height)
            espData.BoxOutline.Position = Vector2.new(rootPos.X - width / 2, headPos.Y)
            espData.BoxOutline.Visible = true
        end
    end
    
    -- Update Name
    if Config.ESP.NameEnabled and espData.Name then
        local nameText = player.Name
        
        if Config.ESP.ShowDistance then
            local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
            nameText = nameText .. string.format(" [%dm]", math.floor(distance))
        end
        
        if Config.ESP.ShowHealth then
            local health, maxHealth = Utility:GetHealth(player)
            nameText = nameText .. string.format(" [%d/%d]", math.floor(health), math.floor(maxHealth))
        end
        
        espData.Name.Text = nameText
        espData.Name.Position = Vector2.new(rootPos.X, headPos.Y - 15)
        espData.Name.Visible = true
    end
    
    -- Update Tracers
    if Config.ESP.TracerEnabled and espData.Tracers then
        local fromPos
        
        if Config.ESP.TracerFrom == "Bottom" then
            fromPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        elseif Config.ESP.TracerFrom == "Top" then
            fromPos = Vector2.new(Camera.ViewportSize.X / 2, 0)
        else
            fromPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        end
        
        espData.Tracers.From = fromPos
        espData.Tracers.To = rootPos
        espData.Tracers.Visible = true
        
        -- Color locked target differently
        if LockedTarget == player then
            espData.Tracers.Color = Color3.fromRGB(255, 0, 0)
            espData.Tracers.Thickness = Config.ESP.TracerThickness + 1
        else
            espData.Tracers.Color = Config.ESP.TracerColor
            espData.Tracers.Thickness = Config.ESP.TracerThickness
        end
    end
    
    -- Update Health Bar
    if Config.ESP.HealthBarEnabled and espData.HealthBar then
        local health, maxHealth = Utility:GetHealth(player)
        local healthPercent = health / maxHealth
        
        local barHeight = height * healthPercent
        
        local barX = rootPos.X - width / 2 - 5
        
        if Config.ESP.HealthBarPosition == "Right" then
            barX = rootPos.X + width / 2 + 5
        end
        
        espData.HealthBar.From = Vector2.new(barX, legPos.Y)
        espData.HealthBar.To = Vector2.new(barX, legPos.Y - barHeight)
        espData.HealthBar.Color = Color3.fromRGB(
            255 * (1 - healthPercent),
            255 * healthPercent,
            0
        )
        espData.HealthBar.Visible = true
        
        if espData.HealthBarOutline then
            espData.HealthBarOutline.From = Vector2.new(barX, legPos.Y)
            espData.HealthBarOutline.To = Vector2.new(barX, headPos.Y)
            espData.HealthBarOutline.Visible = true
        end
    end
    
    -- Update Head Dot
    if Config.ESP.HeadDotEnabled and espData.HeadDot and head then
        local headScreenPos = Utility:WorldToScreen(head.Position)
        espData.HeadDot.Position = headScreenPos
        espData.HeadDot.Visible = true
        
        -- Highlight locked target
        if LockedTarget == player then
            espData.HeadDot.Color = Color3.fromRGB(255, 0, 0)
            espData.HeadDot.Radius = Config.ESP.HeadDotSize + 2
        else
            espData.HeadDot.Color = Config.ESP.HeadDotColor
            espData.HeadDot.Radius = Config.ESP.HeadDotSize
        end
    end
end

function ESP:Update()
    if not Config.ESP.Enabled then
        for player, _ in pairs(ESPObjects) do
            self:RemoveESP(player)
        end
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        self:UpdateESP(player)
    end
end

