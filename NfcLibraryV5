-- // Auto Prediction Logic (Fixed from your messy script)
task.spawn(function()
    while task.wait(1) do
        if getgenv().AimbotConfig.AutoPrediction then
            local ping = tonumber(string.split(Stats.Network.ServerStatsItem["Data Ping"]:GetValueString(), " ")[1])
            if ping < 40 then getgenv().AimbotConfig.Prediction = 0.125
            elseif ping < 60 then getgenv().AimbotConfig.Prediction = 0.122
            elseif ping < 90 then getgenv().AimbotConfig.Prediction = 0.136
            else getgenv().AimbotConfig.Prediction = 0.145 end
        end
    end
end)

-- // Target Function
local function GetClosest()
    local target = nil
    local dist = math.huge
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local pos, onScreen = Camera:WorldToViewportPoint(v.Character.HumanoidRootPart.Position)
            if onScreen then
                local mag = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                if mag < dist then
                    dist = mag
                    target = v
                end
            end
        end
    end
    return target
end

-- // Keybind Toggle
UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == getgenv().AimbotConfig.Keybind then
        if getgenv().AimbotConfig.Enabled then
            if getgenv().AimbotConfig.LockedTarget then
                getgenv().AimbotConfig.LockedTarget = nil
                WindUI:Notify({Title = "Unlocked", Content = "Target Released", Duration = 2})
            else
                getgenv().AimbotConfig.LockedTarget = GetClosest()
                if getgenv().AimbotConfig.LockedTarget then
                    WindUI:Notify({Title = "Locked", Content = "Target: "..getgenv().AimbotConfig.LockedTarget.Name, Duration = 2})
                end
            end
        end
    end
end)

-- // Main Lock Loop (Ace Style)
RunService.RenderStepped:Connect(function()
    if getgenv().AimbotConfig.Enabled and getgenv().AimbotConfig.LockedTarget then
        local targetChar = getgenv().AimbotConfig.LockedTarget.Character
        if targetChar and targetChar:FindFirstChild(getgenv().AimbotConfig.Partz) then
            local root = targetChar[getgenv().AimbotConfig.Partz]
            -- Prediction Math: Position + (Velocity * Prediction)
            local predictedPos = root.Position + (root.Velocity * getgenv().AimbotConfig.Prediction)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, predictedPos)
        end
    end
end)
