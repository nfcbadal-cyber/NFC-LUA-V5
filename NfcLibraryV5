UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Settings.Aimbot.AimlockKey and Settings.Aimbot.Aimlock then
        AimlockActive = true
        
        -- Lock onto closest target
        local target = GetClosestPlayer()
        if target then
            LockedTarget = target
            UpdateLockedHighlight()
            print("🔒 Locked onto: " .. target.Name)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Settings.Aimbot.AimlockKey then
        AimlockActive = false
        LockedTarget = nil
        UpdateLockedHighlight()
        print("🔓 Aimlock released")
    end
end)

