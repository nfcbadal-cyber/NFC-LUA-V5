if StatsTab then
    StatsTab:Label("=== Auto Stats ===")
    
    local PointsToAdd = 1
    local StatsToUpgrade = {
        Melee = false,
        Defense = false,
        Sword = false,
        Gun = false,
        Fruit = false
    }
    
    local function AutoStats()
        task.spawn(function()
            while getgenv().AutoStats do 
                task.wait(0.1)
                if Player.Data.Points.Value >= 1 then
                    local Points = math.clamp(PointsToAdd, 1, Player.Data.Points.Value)
                    if StatsToUpgrade.Melee then FireRemote("AddPoint", "Melee", Points) end
                    if StatsToUpgrade.Defense then FireRemote("AddPoint", "Defense", Points) end
                    if StatsToUpgrade.Sword then FireRemote("AddPoint", "Sword", Points) end
                    if StatsToUpgrade.Gun then FireRemote("AddPoint", "Gun", Points) end
                    if StatsToUpgrade.Fruit then FireRemote("AddPoint", "Demon Fruit", Points) end
                end
            end
        end)
    end
    
    StatsTab:Toggle('Auto Stats', false, function(state)
        getgenv().AutoStats = state
        if state then
            AutoStats()
        end
    end)
    
    StatsTab:Slider("Points Per Upgrade", 1, 100, 1, function(value)
        PointsToAdd = value
    end)
    
    StatsTab:Label("=== Select Stats ===")
    
    StatsTab:Toggle('Melee', false, function(state)
        StatsToUpgrade.Melee = state
    end)
    
    StatsTab:Toggle('Defense', false, function(state)
        StatsToUpgrade.Defense = state
    end)
    
    StatsTab:Toggle('Sword', false, function(state)
        StatsToUpgrade.Sword = state
    end)
    
    StatsTab:Toggle('Gun', false, function(state)
        StatsToUpgrade.Gun = state
    end)
    
    StatsTab:Toggle('Demon Fruit', false, function(state)
        StatsToUpgrade.Fruit = state
    end)
end

