--[[
    NFC SCRIPTS - AIMBOT EDITION
    Integrated with your provided UI Library
]]

local Library = loadstring(game:HttpGet('https://gist.githubusercontent.com/MjContiga1/5b9535166d60560ac884a871cb0dc418/raw/e7fdb16802d9486d8d04d3e41d3607d89e6b4a1b/Libsuck.lua'))()

-- // Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local Camera = workspace.CurrentCamera

-- // Aimbot Variables
getgenv().AimbotEnabled = false
getgenv().TeamCheck = false
getgenv().AimbotPart = "Head"
getgenv().FOVVisible = true
getgenv().FOVRadius = 100
getgenv().FOVColor = Color3.fromRGB(255, 255, 255)

-- // FOV Circle Setup
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.NumSides = 460
FOVCircle.Filled = false
FOVCircle.Transparency = 1

-- // Functions
local function GetClosestPlayer()
    local MaximumDistance = getgenv().FOVRadius
    local Target = nil

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if getgenv().TeamCheck and v.Team == LocalPlayer.Team then continue end
            
            local ScreenPoint, OnScreen = Camera:WorldToScreenPoint(v.Character[getgenv().AimbotPart].Position)
            local Distance = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(ScreenPoint.X, ScreenPoint.Y)).Magnitude
            
            if Distance < MaximumDistance and OnScreen then
                MaximumDistance = Distance
                Target = v
            end
        end
    end
    return Target
end

-- // Aimbot Loop
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = getgenv().FOVVisible
    FOVCircle.Radius = getgenv().FOVRadius
    FOVCircle.Position = Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
    FOVCircle.Color = getgenv().FOVColor

    if getgenv().AimbotEnabled then
        local Target = GetClosestPlayer()
        if Target then
            -- This is "Silent Aim" logic (Modifies the Camera view)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Character[getgenv().AimbotPart].Position)
        end
    end
end)

-- // UI SETUP
local window = Library:Window('NFC SCRIPTS | AIMBOT')

local mainTab = window:Tab({"Combat", "rbxassetid://7734022041"})
local localTab = window:Tab({"LocalPlayer", "rbxassetid://7743875962"})
local settingsTab = window:Tab({"Settings", "rbxassetid://7733673987"})

-- // Combat Tab (Aimbot Features)
mainTab:Label("Aimbot Settings")

mainTab:Toggle('Enable Aimbot', false, function(state)
    getgenv().AimbotEnabled = state
end)

mainTab:Toggle('Team Check', false, function(state)
    getgenv().TeamCheck = state
end)

mainTab:Dropdown("Target Part", {"Head", "HumanoidRootPart"}, function(selected)
    getgenv().AimbotPart = selected
end)

mainTab:Label("FOV Visuals")

mainTab:Toggle('Show FOV Circle', true, function(state)
    getgenv().FOVVisible = state
end)

mainTab:Slider("FOV Radius", 10, 500, 100, function(value)
    getgenv().FOVRadius = value
end)

-- // LocalPlayer Tab
localTab:Label("Character Modification")

localTab:Slider("Walk Speed", 16, 250, 16, function(value)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = value
    end
end)

localTab:Slider("Jump Power", 50, 500, 50, function(value)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = value
    end
end)

localTab:Toggle("Infinite Jump", false, function(state)
    getgenv().InfJump = state
    UserInputService.JumpRequest:Connect(function()
        if getgenv().InfJump then
            LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
        end
    end)
end)

-- // Settings Tab
settingsTab:Label("UI Customization")

settingsTab:Button('Destroy UI', function()
    FOVCircle:Remove()
    -- Logic to close/destroy UI
end)

settingsTab:Keybind("Toggle Menu", Enum.KeyCode.RightShift, function()
    -- Library toggle logic usually handled by the Lib
    print("Menu Toggled")
end)

print("Aimbot Script Loaded Successfully!")
