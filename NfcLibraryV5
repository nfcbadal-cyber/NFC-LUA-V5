-- Auto Farm Level
function AutoFarm_Level()
    task.spawn(function()
        while getgenv().AutoFarm_Level do
            task.wait()
            pcall(function()
                local questData = FireRemote("PlayerLevel")
                if questData and questData.Enemy then
                    local enemyName = questData.Enemy
                    
                    -- Get quest if needed
                    local questInfo = GetQuestInfo()
                    if not questInfo.Active then
                        FireRemote("StartQuest", questData.QuestName, questData.QuestNum)
                    end
                    
                    -- Farm enemy
                    for _, enemy in pairs(Enemies:GetChildren()) do
                        if enemy.Name == enemyName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
                            if enemyRoot then
                                repeat
                                    task.wait()
                                    EquipBestTool()
                                    TeleportTo(enemyRoot.CFrame * CFrame.new(0, 20, 0))
                                    UseSkills()
                                until not getgenv().AutoFarm_Level or enemy.Humanoid.Health <= 0
                            end
                        end
                    end
                end
            end)
        end
    end)
end

