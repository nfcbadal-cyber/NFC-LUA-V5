-- Aimbot Loop
RunService.RenderStepped:Connect(function()
    -- Update FOV Circle position
    if Settings.Visuals.FOVCircle then
        local MousePos = UserInputService:GetMouseLocation()
        FOVCircle.Position = MousePos
    end
    
    -- Aimbot
    if Settings.Aimbot.Enabled or Settings.Aimbot.Aimlock then
        local Target = GetClosestPlayer()
        
        if Target and Target.Character and Target.Character:FindFirstChild(Settings.Aimbot.AimPart) then
            local TargetPart = Target.Character[Settings.Aimbot.AimPart]
            local CameraPosition = Camera.CFrame.Position
            local TargetPosition = TargetPart.Position
            
            -- Predict movement (basic)
            if TargetPart:IsA("BasePart") and TargetPart.AssemblyLinearVelocity then
                TargetPosition = TargetPosition + (TargetPart.AssemblyLinearVelocity * 0.1)
            end
            
            local NewCFrame = CFrame.new(CameraPosition, TargetPosition)
            
            if Settings.Aimbot.Aimlock then
                Camera.CFrame = NewCFrame
            else
                Camera.CFrame = Camera.CFrame:Lerp(NewCFrame, Settings.Aimbot.Smoothness)
            end
        end
    end
    
    -- Update Tracers
    if Settings.Visuals.TracersEnabled then
        UpdateTracers()
    end
end)

-- Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if Settings.Movement.InfiniteJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Character respawn handling
LocalPlayer.CharacterAdded:Connect(function(character)
    wait(0.5)
    
    -- Reapply speed/jump if needed
    local humanoid = character:WaitForChild("Humanoid")
    
    if Settings.Movement.SpeedBoost then
        humanoid.WalkSpeed = Settings.Movement.OriginalSpeed * 2
    end
    
    if Settings.Movement.JumpPower then
        humanoid.JumpPower = Settings.Movement.OriginalJump * 2
    end
    
    -- Reapply NoClip if enabled
    if Settings.Movement.NoClip then
        ToggleNoClip(true)
    end
    
    -- Reapply Fly if enabled
    if Settings.Movement.Fly then
        wait(1)
        ToggleFly(true)
    end
end)

